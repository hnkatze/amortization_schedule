---
import "../styles/global.css";

type Props = {
  readonly title: string;
  readonly description: string;
};

const { title, description } = Astro.props;

/*
 * From `lg` up the document itself stops scrolling: the body height is pinned
 * to the viewport and each panel owns its overflow, so the schedule can take
 * whatever vertical space is left instead of pushing the page down. Below `lg`
 * there is not enough room to give every region its own scrollbar, so normal
 * document flow stays in charge.
 */
---

<!doctype html>
<html lang="es" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body
    class="min-h-full bg-slate-50 text-slate-900 antialiased lg:flex lg:h-dvh lg:flex-col lg:overflow-hidden dark:bg-slate-950 dark:text-slate-100"
  >
    <a
      class="sr-only rounded-lg bg-sky-600 px-4 py-2 font-medium text-white focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50"
      href="#main"
    >
      Saltar al contenido
    </a>
    <slot />
  </body>
</html>
